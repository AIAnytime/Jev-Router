# --- Jev decision engine (required for Jev-powered routing; falls back to heuristics without it)
JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-latest
# JEV_TIMEOUT=8

# --- Providers (a provider's models are enabled automatically when its key is set)
LIQUID_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_ENABLED=true

# --- Router
# Comma-separated keys clients must send as "Authorization: Bearer <key>". Empty = open (local dev only).
JEV_ROUTER_API_KEYS=
# JEV_ROUTER_CONFIG_DIR=config
# DEFAULT_STRATEGY=balanced          # balanced | quality | cheapest | fastest | privacy
# CONFIDENCE_THRESHOLD=0.55
# MAX_FALLBACKS=3
# RATE_LIMIT_RPM=120                  # per API key, 0 disables
# DECISION_CACHE_TTL=600
# LOG_PROMPTS=true                    # store a 300-char prompt preview with each trace
# DATABASE_URL=sqlite+aiosqlite:///./data/jev_router.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/jev_router
